VITE_BASE=/

# 接口地址：生产构建走同源 /api（nginx 容器反代到后端），不再使用模板 mock 地址
VITE_GLOB_API_URL=/api

# 是否开启压缩，可组合：none / gzip / brotli / gzip,brotli（构建产出 .gz 与 .br 预压缩产物）
VITE_COMPRESS=gzip,brotli

# 是否开启 PWA
VITE_PWA=false

# vue-router 的模式
VITE_ROUTER_HISTORY=hash

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 打包后是否生成dist.zip（容器镜像内不需要产物压缩包）
VITE_ARCHIVER=false
